import BaseLayout from '../layouts/BaseLayout.astro';
import {company} from '../data/site';
import {partners} from '../data/partners';
import {products} from '../data/products';
import ModelStage from '../components/ModelStage.astro';
import Wordmark from '../components/Wordmark.astro';
import QrPopover from '../components/QrPopover.astro';
import {SITE_URL} from '../data/site';
import {waLink} from '../lib/whatsapp';
const guitar=products.find(p=>p.slug==='kursi-gitar')!;
const services=[['Augmented Reality','Produk hadir di ruangan pelanggan melalui kamera ponsel.'],['Visualisasi 3D','Representasi digital untuk melihat bentuk dan detail produk.'],['Pengalaman WebAR','Katalog produk terbuka dari tautan tanpa memasang aplikasi.'],['Strategi Pengalaman Digital','Rancangan pengalaman yang menghubungkan produk dengan pelanggan.']];
---
<BaseLayout><div class="wrap"><header class="site-header"><a href="/" aria-label="LunAR, Beranda"><Wordmark /></a><nav class="nav" aria-label="Navigasi utama"><a href="/">Beranda</a><a href="/tentang/">Tentang</a><a href="/layanan/">Layanan</a><a href="/portofolio/">Portofolio</a><a href="/kontak/">Kontak</a><a class="button button-primary header-cta" href={waLink('Halo LunAR, saya ingin berdiskusi tentang produk saya.')}>Hubungi Kami</a></nav><button class="menu-button" aria-expanded="false" aria-controls="mobile-nav">Menu</button><nav class="mobile-sheet" id="mobile-nav" hidden aria-label="Navigasi seluler"><a href="/">Beranda</a><a href="/tentang/">Tentang</a><a href="/layanan/">Layanan</a><a href="/portofolio/">Portofolio</a><a href="/kontak/">Kontak</a><a href={waLink('Halo LunAR, saya ingin berdiskusi tentang produk saya.')}>Hubungi Kami</a></nav></header>
<main id="konten"><section class="hero"><div class="ribbon"></div><div class="ribbon ribbon-two"></div><div class="hero-copy"><p class="eyebrow">Pengalaman produk lewat AR</p><h1>Bawa Produk Anda Langsung <span>ke Ruang Tamu Pembeli.</span></h1><p>LunAR membantu bisnis furnitur menghadirkan produk ke ruang pelanggan melalui pengalaman AR dan WebAR. Pelanggan dapat melihat produk dari ponsel mereka, tanpa aplikasi.</p><div class="hero-actions"><a class="button button-primary" href={waLink('Halo LunAR, saya ingin tahu bagaimana produk saya bisa dicoba pelanggan lewat AR.')}>Ceritakan Produk Anda</a><a href="#ruang">Coba kursinya di ruangan Anda ↓</a></div><p class="hero-note">// VERIFY: waktu balasan belum dikonfirmasi.</p></div><div class="room" id="ruang"><!-- TEMP: legacy room image; replace after image review. --> <img src="/images/hero-room.jpg" width="1280" height="1920" fetchpriority="high" alt="Ilustrasi ruang tamu dengan area untuk melihat produk."/><ModelStage product={guitar}/><div class="room-caption"><span>Kursi Gitar · pratinjau model 3D</span><a href="/portofolio/kursi-gitar/">Buka produk →</a><QrPopover href={`${SITE_URL}/portofolio/kursi-gitar/`}/></div></div></section></div>
<section class="section section-band"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Tantangan</p><h2>Pelanggan Melihat Fotonya. Tapi Bisakah Mereka Membayangkannya?</h2></div><p>Foto dan katalog menunjukkan bentuk produk. Tapi pertanyaan sebelum membeli belum terjawab: muat atau tidak di ruangan saya? Cocok atau tidak dengan lantai dan dindingnya?</p></div><div class="problem-grid"><div class="rows"><div class="row"><b>Visualisasi</b><span>Pelanggan sulit membayangkan produk di ruangan mereka sendiri.</span></div><div class="row"><b>Pengalaman Statis</b><span>Foto itu informatif, tapi pasif dan mudah terlewat.</span></div><div class="row"><b>Kepercayaan Membeli</b><span>Makin besar pembeliannya, makin besar keyakinan yang dibutuhkan.</span></div></div><div class="chat"><span class="chat-label">Ilustrasi percakapan</span><p class="bubble">Kak, ada ukuran lain untuk sofa L-nya?</p><p class="bubble right">(mengirim foto-foto)</p><p class="bubble">Terima kasih infonya Kak, saya ukur ruangan dulu ya.</p><p><b>Biarkan pelanggan mencobanya sendiri.</b></p></div></div></div></section>
<section class="section"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Cara Kerja</p><h2>Bagaimana Jika Mereka Bisa Mencobanya Sebelum Membeli?</h2></div><p>Pelanggan membuka produk dari tautan atau QR, menaruhnya di ruangan melalui kamera ponsel, dan melihatnya dari berbagai sisi. Tanpa aplikasi.</p></div><div class="steps">{[['Scan','Pindai kode QR atau buka tautan yang Anda bagikan.'],['Buka','Halaman produk langsung terbuka di browser.'],['Tempatkan','Arahkan kamera ke lantai, lalu tempatkan produk.'],['Rasakan','Putar dan lihat produk dari berbagai sudut.']].map(([name,desc],i)=><article class="step"><span class="step-num">0{i+1}</span><h3>{name}</h3><p>{desc}</p></article>)}</div><p style="margin-top:32px">iPhone memakai AR Quick Look; Android memakai Google Scene Viewer. Lalu pelanggan dapat menghubungi Anda lewat WhatsApp.</p></div></section>
<section class="section section-band"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Layanan</p><h2>Apa yang Kami Kerjakan</h2></div><p>Kami menghubungkan produk fisik dengan pengalaman digital yang dapat dijelajahi pelanggan.</p></div><div class="bento">{services.map((item,i)=><a class:list={['tile',i===3&&'tile-wide']} href="/layanan/"><span class="eyebrow">0{i+1}</span><h3>{item[0]}</h3><p>{item[1]}</p></a>)}</div></div></section>
<section class="section"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Untuk Bisnis Furnitur</p><h2>Dibuat untuk Showroom, Pabrik, dan Pengrajin Furnitur</h2></div><p>Mulai dari produk yang sudah Anda kenal. Kami bantu merancang cara pelanggan melihat dan menjelajahinya.</p></div><ol class="index-list"><li><b>Anda punya produk, bukan file 3D.</b><p>// VERIFY: alur pembuatan model dari foto dan ukuran perlu dikonfirmasi.</p></li><li><b>Satu tautan untuk dibagikan.</b><p>// VERIFY: QR untuk label showroom perlu dikonfirmasi.</p></li><li><b>Pembeli tidak perlu mengunduh aplikasi.</b><p>Buka tautan produk, lalu lanjutkan ke pengalaman AR yang tersedia di perangkat.</p></li><li><b>Pemesanan tetap lewat WhatsApp.</b><p>Setiap produk dapat memiliki tautan percakapan yang sudah terisi.</p></li><li><b>Desain Anda tetap milik Anda.</b><p>// VERIFY: detail pemrosesan model, watermark, dan dukungan pendaftaran desain perlu dikonfirmasi.</p></li></ol></div></section>
<section class="section section-band"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Portofolio</p><h2>Produk dalam Pengalaman AR</h2></div><p>// VERIFY: status katalog AR Grizelle dan fokus proyek furnitur perlu dikonfirmasi. Kursi Gitar ditampilkan sebagai contoh furnitur.</p></div><!-- TEMP: legacy catalog imagery; replace after image review. --><div class="product-rail">{products.map(p=><a class="product-card" href={`/portofolio/${p.slug}/`}>{p.photo?<img src={p.photo} alt={`Foto ${p.name}`}/>:<span class="product-placeholder">TEMP · poster Kursi Gitar</span>}<div><span class="product-meta">{p.category}</span><h3>{p.name}</h3><span>Lihat produk →</span></div></a>)}</div><h3 style="margin-top:42px">Situs yang Sudah Kami Bangun</h3><p>// VERIFY: persetujuan penggunaan logo klien perlu dikonfirmasi.</p><div class="partners">{partners.map(p=><a class="partner" href={p.url} target="_blank" rel="noopener" aria-label={`Kunjungi situs ${p.name}`}><img src={p.image} alt=""/></a>)}</div><p style="margin-top:24px"><a href="/portofolio/">Lihat semua portofolio →</a></p></div></section>
<section class="section"><div class="wrap"><div class="section-intro"><div><p class="eyebrow">Proses</p><h2>Dari Obrolan Pertama sampai Siap Dipakai</h2></div><p>Langkah kerja disesuaikan dengan produk dan kebutuhan pengalaman digital Anda.</p></div><div class="process">{[['Discover','Kami pelajari produk dan tujuan Anda.'],['Design','Kami rancang pengalaman digital yang sesuai.'],['Develop','Kami bangun dan hidupkan pengalamannya.'],['Deliver','Kami luncurkan dan bantu Anda mengembangkannya.']].map(([a,b],i)=><div><span class="product-meta">0{i+1}</span><h3>{a}</h3><p>{b}</p></div>)}</div><p><a href="/layanan/">Lihat langkah pemesanan →</a></p></div></section>
<section class="contact-band"><div class="wrap"><p class="eyebrow">Mulai percakapan</p><h2>Punya Produk yang Ingin Dicoba Pelanggan Sebelum Membeli?</h2><p>Ceritakan produk dan tujuan Anda.</p><div class="contact-links"><a class="button button-primary" href={waLink('Halo LunAR, saya ingin membicarakan produk saya dan pengalaman AR.')}>Chat via WhatsApp</a><a href={`mailto:${company.email}`}>{company.email}</a><span>{company.address}</span></div></div></section></main><footer class="site-footer"><div class="wrap footer-grid"><a href="/" aria-label="LunAR Beranda"><Wordmark variant="stacked"/></a><nav aria-label="Navigasi footer"><a href="/tentang/">Tentang</a> · <a href="/layanan/">Layanan</a> · <a href="/portofolio/">Portofolio</a> · <a href="/kontak/">Kontak</a></nav><div><p>{company.email}</p><a href={company.instagram}>Instagram @lunar_creativa</a></div><p>© 2026 LunAR. Dibuat di Surakarta.</p></div></footer></BaseLayout>
<script>
const menu=document.querySelector('.menu-button');const sheet=document.querySelector('.mobile-sheet');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')==='true';menu.setAttribute('aria-expanded',String(!open));sheet?.toggleAttribute('hidden',open);if(!open)sheet?.querySelector('a')?.focus()});sheet?.addEventListener('keydown',(e)=>{if(e.key==='Escape'){sheet.setAttribute('hidden','');menu?.setAttribute('aria-expanded','false');menu?.focus()}if(e.key==='Tab'){const links=[...sheet.querySelectorAll('a')];if(e.shiftKey&&document.activeElement===links[0]){e.preventDefault();links.at(-1)?.focus()}else if(!e.shiftKey&&document.activeElement===links.at(-1)){e.preventDefault();links[0]?.focus()}}});
</script>





