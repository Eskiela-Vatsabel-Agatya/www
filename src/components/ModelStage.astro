---
import { R2 } from '../lib/r2';
const {product}=Astro.props;
const poster=product.photo ?? '/images/chair-poster.svg';
const url=R2(product.model.glb); const usdz=R2(product.model.usdz);
---
<div class="media-panel hero-model-stage" data-model-stage data-state="idle"><img class="stage-poster" src={poster} alt={product.photo?`Foto ${product.name}`:`TEMP ilustrasi netral sebagai poster ${product.name}`}/><model-viewer src={url} ios-src={usdz} ar ar-modes="scene-viewer webxr quick-look" camera-controls disable-zoom touch-action="pan-y" shadow-intensity="0.5" alt={`Pratinjau 3D ${product.name}`} reveal="manual" ar-placement={product.arPlacement} ar-scale={product.arPlacement ? 'fixed' : undefined}><button slot="ar-button" class="model-ar-action" hidden>Lihat di Ruangan Anda</button></model-viewer><p class="model-status" aria-live="polite"></p><button class="button button-secondary model-button" type="button">Muat Tampilan 3D</button></div>
<script>
const root=document.querySelector<HTMLElement>('[data-model-stage]');
if(root){
  const viewer=root.querySelector('model-viewer') as (HTMLElement & {dismissPoster:()=>void}) | null;
  const button=root.querySelector<HTMLButtonElement>('.model-button');
  const poster=root.querySelector<HTMLImageElement>('.stage-poster');
  const status=root.querySelector<HTMLParagraphElement>('.model-status');
  const connection=(navigator as Navigator & {connection?:{saveData?:boolean;effectiveType?:string}}).connection;
  let timer:ReturnType<typeof setTimeout>|undefined;
  if(viewer&&button&&poster&&status){
    const constrained=()=>connection?.saveData||['slow-2g','2g'].includes(connection?.effectiveType??'')||matchMedia('(prefers-reduced-data: reduce)').matches;
    const load=async()=>{
      root.dataset.state='loading';status.textContent='Menyiapkan pratinjau 3D…';button.disabled=true;
      try{
        await import('@google/model-viewer');
        timer=setTimeout(()=>{root.dataset.state='failed';poster.hidden=false;button.disabled=false;status.textContent='';},15000);
        viewer.addEventListener('load',()=>{if(timer)clearTimeout(timer);viewer.hidden=false;poster.hidden=true;viewer.dismissPoster();root.dataset.state='ready';button.hidden=true;const arAction=viewer.querySelector<HTMLElement>('.model-ar-action');if(arAction)arAction.hidden=false;status.textContent='Pratinjau 3D siap';},{once:true});
        viewer.addEventListener('error',()=>{if(timer)clearTimeout(timer);root.dataset.state='failed';poster.hidden=false;button.disabled=false;status.textContent='';},{once:true});
        viewer.dismissPoster();
      }catch{root.dataset.state='failed';poster.hidden=false;button.disabled=false;status.textContent='';}
    };
    if(constrained()){root.dataset.state='constrained';status.textContent='Tampilan 3D dimuat sesuai permintaan Anda.'}
    else{const io=new IntersectionObserver(([entry])=>{if(entry.isIntersecting){io.disconnect();void load()}},{rootMargin:'100px'});io.observe(root)}
    button.addEventListener('click',()=>void load());
  }
}
</script>




